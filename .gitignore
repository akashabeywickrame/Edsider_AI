venv/
__pycache__/
*.pyc
data/*.db
data/*.db-shm
data/*.db-wal
# Compressed copies made for uploading a bank to a server
# (scripts/prepare_upload_db.py) - same real data, same rule.
data/*.db.gz
data/*.db.zip
.pytest_cache/

# Real EdSider exports. Their question bank is not ours to commit.
data/*.csv
data/edsider_*.json
# Same export, from before this file's own data/*.csv rule existed - at
# the repo root, wrong extension for that rule to catch. 684 MB, and it
# is real EdSider data, not ours to commit either.
edsider_questions.csv.pub

# Real database credentials for scripts/sync.py. Never committed -
# .env.example documents what belongs here with no real values.
.env

# Timestamped safety-net copies of a real database, taken before a risky
# operation (see CLAUDE.md). Real data, and large - never committed.
data/*.bak*

# Local copy of the bank's fingerprints (store._cached_vectors) - derived
# from the database, rebuilt on demand, and 50 MB of real data.
data/cache/

# The local reader's own install (setup.bat) and in-flight uploads.
local_reader/venv/
local_reader/llamacpp/
local_reader/_upload_*

# Office lock files, present while a document is open in Word/Excel.
~$*
