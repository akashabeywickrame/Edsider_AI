# service.py's own address - see CLAUDE.md, "The live service".
# Defaults to this if unset (see src/lib/api.js), so .env itself is
# only needed to point at something else (a deployed API, a different
# port).
VITE_API_BASE_URL=http://localhost:8000

# Matches EDSIDER_API_KEY on that server (see service.py's require_api_key),
# when one is set there - leave unset for a local backend, which has none.
# Baked into the built JS, so this is a gate on casual public access, not
# real authentication - see api.js's own note.
VITE_API_KEY=
