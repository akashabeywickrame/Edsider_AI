# service.py's own address - see CLAUDE.md, "The live service".
# Defaults to this if unset (see src/lib/api.js), so .env itself is
# only needed to point at something else (a deployed API, a different
# port).
VITE_API_BASE_URL=http://localhost:8000

# Matches EDSIDER_API_KEY on that server (see service.py's require_api_key),
# when one is set there - leave unset for a local backend, which has none.
# Baked into the built JS, so this is a gate on casual public access, not
# real authentication - see api.js's own note.
VITE_API_KEY=

# Single sign-on from EdSider: the name EdSider's sign-in (Azure AD B2C) has
# as an OpenID Connect provider in this app's Easy Auth (/.auth/login/<name>).
# Set, EdSider's login is the only way in - no sign-in page here; someone
# signed in to EdSider is not asked again (src/lib/auth.js). Needs
# EDSIDER_REQUIRE_SIGNIN=true on the API, so a visit with no sign-in is sent
# to sign in rather than treated as a local run.
VITE_EDSIDER_SSO_PROVIDER=
