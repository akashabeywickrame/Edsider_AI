# Copy this file to .env and fill in real values. .env itself is
# gitignored - never commit real credentials.
#
# OUR OWN database - the bank, the intake drafts and the decisions.
# PostgreSQL, on EdSider's own server. Read by store.connect().
#
# Keyword form, not a postgresql:// URL: a password containing @ : or /
# breaks the URL form (everything after the @ is read as the host).
# Single-quote the password.
EDSIDER_DB=host=HOST port=5432 dbname=edsider_ai user=USER password='PASSWORD'

# Where the test suite builds and drops its own throwaway schemas. A
# LOCAL PostgreSQL: every test opens several connections, and over the
# network to Azure the suite takes a quarter of an hour instead of
# seconds. Never the real bank.
EDSIDER_TEST_DB=host=127.0.0.1 port=5432 dbname=edsider_ai_test user=postgres password='PASSWORD'

#
# Needed by scripts/sync.py to pull directly from EdSider's own
# PostgreSQL. The account behind these credentials must be READ-ONLY -
# SELECT on question.question, assessment.assessment_question, the
# settings.grade/subject/language lookup tables, and - for the teacher
# list (sync_teachers) - user_management.staff_user,
# user_management.staff_user_role and registration.teacher. Nothing else.

PG_HOST=
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=
